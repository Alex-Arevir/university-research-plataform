{
  "info": {
    "name": "Research University",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost/research-university/backend"
    },
    {
      "key": "username",
      "value": "demo.estudiante"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "proposalId",
      "value": ""
    },
    {
      "key": "researcherId",
      "value": ""
    },
    {
      "key": "evaluatorId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Acceso",
      "item": [
        {
          "name": "POST auth/login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login.php",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "GET auth/session",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/session.php"
          }
        },
        {
          "name": "POST auth/logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout.php",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "GET users/list",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/list.php"
          }
        },
        {
          "name": "GET users/detail",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/detail.php?user_id={{userId}}"
          }
        },
        {
          "name": "POST users/create",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users/create.php",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cuenta de prueba\",\n  \"username\": \"prueba.temporal\",\n  \"role\": \"student\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "POST users/update",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users/update.php",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{userId}}\",\n  \"name\": \"Cuenta actualizada\",\n  \"username\": \"prueba.temporal\"\n}"
            }
          }
        },
        {
          "name": "POST users/change-role",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users/change-role.php",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{userId}}\",\n  \"role\": \"student\"\n}"
            }
          }
        },
        {
          "name": "POST users/change-status",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users/change-status.php",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{userId}}\",\n  \"status\": \"inactive\"\n}"
            }
          }
        },
        {
          "name": "POST users/reset-password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users/reset-password.php",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{userId}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "GET catalogs/roles",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/catalogs/roles.php"
          }
        }
      ]
    },
    {
      "name": "Propuestas",
      "item": [
        {
          "name": "GET catalogs/researchers",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/catalogs/researchers.php"
          }
        },
        {
          "name": "POST proposals/create",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/proposals/create.php",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Aprendizaje digital\",\n  \"description\": \"Estudio de uso de herramientas digitales.\",\n  \"objectives\": \"Medir su impacto.\",\n  \"responsible_researcher_id\": \"{{researcherId}}\"\n}"
            }
          }
        },
        {
          "name": "GET proposals/list",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/proposals/list.php?archived=0&page=1&limit=20"
          }
        },
        {
          "name": "GET proposals/detail",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/proposals/detail.php?proposal_id={{proposalId}}"
          }
        },
        {
          "name": "POST proposals/update",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/proposals/update.php",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"proposal_id\": \"{{proposalId}}\",\n  \"objectives\": \"Medir el impacto en un grupo piloto.\"\n}"
            }
          }
        },
        {
          "name": "POST proposals/resubmit",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/proposals/resubmit.php",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"proposal_id\": \"{{proposalId}}\"\n}"
            }
          }
        },
        {
          "name": "POST proposals/review",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/proposals/review.php",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"proposal_id\": \"{{proposalId}}\",\n  \"decision\": \"changes_requested\",\n  \"observations\": \"Delimita el grupo piloto.\"\n}"
            }
          }
        },
        {
          "name": "POST proposals/archive",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/proposals/archive.php",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"proposal_id\": \"{{proposalId}}\",\n  \"archived\": true\n}"
            }
          }
        },
        {
          "name": "GET proposals/history",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/proposals/history.php?proposal_id={{proposalId}}"
          }
        }
      ]
    },
    {
      "name": "Evaluaciones",
      "item": [
        {
          "name": "GET catalogs/evaluators",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/catalogs/evaluators.php"
          }
        },
        {
          "name": "POST evaluations/assign",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/evaluations/assign.php",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"proposal_id\": \"{{proposalId}}\",\n  \"evaluator_id\": \"{{evaluatorId}}\"\n}"
            }
          }
        },
        {
          "name": "GET evaluations/assignments",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/evaluations/assignments.php"
          }
        }
      ]
    }
  ]
}
